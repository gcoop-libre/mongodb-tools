# shellcheck disable=SC1090

[[ "$BASH_DEBUG" -eq 1 ]] && set -x

BIN="$(basename "$0")"

function stderror()
{
  echo >&2 "$1"
}

function die()
{
  stderror "$1"
  exit 1
}

function temporal()
{
  TMPI="$(mktemp)"
  TMPO="$(mktemp)"
  true > "$TMPI"
  true > "$TMPO"
}

function clean()
{
  [[ "$BASH_DEBUG" -eq 0 ]] && rm -f "$TMPI" "$TMPO"
}

function read_piped_input()
{
  while IFS= read -r PIPED_INPUT
  do
    echo "$PIPED_INPUT" >> "$TMPI"
  done
}

function defaults()
{
  [[ -n "$DB_CONF"  ]] || DB_CONF='.mng'
  [[ -n "$DB_NAME"  ]] || DB_NAME='test'
  [[ -n "$DB_AUTH"  ]] || DB_AUTH='admin'
  [[ -n "$DB_HOST"  ]] || DB_HOST='localhost'
  [[ -n "$DB_MECH"  ]] || DB_MECH='SCRAM-SHA-1'
  [[ -n "$DB_PORT"  ]] || DB_PORT='27017'
  [[ -n "$DB_USER"  ]] || DB_USER=''
  [[ -n "$DB_PASS"  ]] || DB_PASS=''
  [[ -n "$TO_JSON"  ]] || TO_JSON=0
  [[ -n "$TWO_COLS" ]] || TWO_COLS=0
  [[ -n "$QUIET"    ]] || QUIET=0
  [[ -n "$CAT"      ]] || CAT="/usr/bin/cat $TMPI"
  [[ -n "$VIM"      ]] && CAT="bat --style=plain,changes -l js $TMPI"
  [[ -n "$MDC"      ]] || MDC='~~~'
  [[ -n "$MDQ"      ]] || MDQ="${MDC}js"
}

function params()
{
  if [[ -z "$1" ]]
  then
    if [[ -t 0 ]]
    then
      :
    else
      read_piped_input
    fi
  else
    if [[ -s "$1" ]]
    then
      cp -f "$1" "$TMPI" >/dev/null
    else
      echo "$*" > "$TMPI"
    fi
  fi

  [[ -s "$TMPI"     ]] || echo 'show collections' > "$TMPI"
  [[ -s "$TMPI"     ]] || die "EMPTY INPUT"

}

function hide_credentials()
{
  echo "${1//$DB_USER:$DB_PASS@/$DB_USER:********@}"
}

cfg_load ()
{
  [[ -s "$DB_CONF" ]] || return

  while read -r LINE
  do

    [[ "$LINE"   =~ ^\#.*     ]] && continue
    KEY="${LINE%%=*}"
    VAL="${LINE##*=}"
    declare -g "$KEY=$VAL"
    [[ "$QUIET" -eq 0         ]] && stderror "READ $DB_CONF SET $LINE"

  done < "$DB_CONF"

  if [[ -z "$DB_URI" ]]
  then
    if [[ -z "$DB_USER" ]]
    then
      DB_URI="mongodb://${DB_HOST}:${DB_PORT}/${DB_NAME}"
    else
      if [[ -z "$DB_PASS" ]]
      then
        DB_URI="mongodb://${DB_USER}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
      else
        DB_URI="mongodb://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}"
      fi
    fi
  fi

  DB_URL="$(hide_credentials "$DB_URI")"

  [[ "$QUIET" -eq 0 ]] \
    && stderror "READ $DB_CONF SET DB_URI=$DB_URL"
}

function code()
{
  printf "%s\\n\\n"    "$MDQ"
  bash -c "$CAT"
  printf "\\n%s\\n\\n" "$MDC"
}

function add_db_name()
{
  sed -i "1i use $DB_NAME" "$TMPI"
}

function query_time()
{
  if command -v sec2hms >/dev/null 2>/dev/null
  then
    stderror "$(sec2hms "$E_SEC")"
  else
    stderror "$E_SEC seconds"
  fi
}

function query()
{

  add_db_name

  CMD='mongosh'
  CMD+=' --quiet'
  CMD+=' --norc'
  CMD+=' --shell'
  [[ "$TO_JSON" -eq 1 ]] && CMD+=' --json'
  CMD+=" --port $DB_PORT"
  CMD+=" --host $DB_HOST"
  [[ -z "$DB_USER" ]] || CMD+=" --username $DB_USER"
  [[ -z "$DB_PASS" ]] || CMD+=" --password $DB_PASS"

  E_BEG="$(LC_ALL=c date +%s)"

  bash -c "$CMD < $TMPI > $TMPO" || die "FAIL MONGO QUERY"

  E_END="$(LC_ALL=c date +%s)"
  E_SEC="$((E_END - E_BEG))"

  [[ -n "$VIM" ]] && code

  SED="s/^$DB_NAME> //g;"
  SED+="s/^$DB_NAME$//g;"
  SED+="s/\.\.\.\ //g"

  sed "$SED" "$TMPO"                                    \
    | grep -vE "(already|switched) (on|to) db $DB_NAME" \
    | grep -vE '^$'

  stderror ""

  [[ "$QUIET" -eq 0 ]] && query_time
}

function main()
{
  temporal
  defaults
  params "$@"
  cfg_load
  query
  clean
}

main "$@"
